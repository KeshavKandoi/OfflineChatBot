import { useEffect, useState } from "react";
import DownloadPage from "./DownloadPage.jsx";
import ArchitecturePage from "./ArchitecturePage.jsx";
import Shuffle from "./Shuffle";
import SilkBackground from "./components/SilkBackground";

export default function App() {
  const [page, setPage] = useState('home');

  useEffect(() => {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) entry.target.classList.add('visible');
      });
    }, { threshold: 0.1 });
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
    return () => observer.disconnect();
  }, []);

  if (page === 'download') {
    return <DownloadPage onBack={() => setPage('home')} />
  }

  if (page === 'architecture') {
    return <ArchitecturePage onBack={() => setPage('home')} />
  }

  return (
    <>
      <SilkBackground />
      <nav>
        <div className="nav-inner liquid-glass">
          <div className="nav-logo">NexaChat</div>
          <ul className="nav-links">
            <li><a href="#features">Features</a></li>
            <li><a href="#stack">Architecture</a></li>
            <li><a href="#stack">Models</a></li>
            <li><a href="#stack">Memory</a></li>
            <li><a href="#stack">Tech Stack</a></li>
            <li><a href="https://github.com/KeshavKandoi/OfflineChatBot">Docs</a></li>
          </ul>
          <div className="nav-right">
            <a href="#download" onClick={(e) => { e.preventDefault(); setPage('download'); window.scrollTo(0,0); }} className="nav-download">Download</a>
          </div>
        </div>
      </nav>
      <style>{`
        nav { position: sticky; top: 0; z-index: 100; padding: 20px 24px; }
        .nav-inner { max-width: 1000px; margin: 0 auto; border-radius: 100px; padding: 12px 24px; display: flex; align-items: center; justify-content: space-between; }
        .logo { font-weight: 700; font-size: 17px; }
        .logo span { color: #c084fc; }
        .nav-links { display: flex; gap: 32px; list-style: none; font-size: 14px; color: rgba(255,255,255,0.7); }
        .nav-links a:hover { color: #fff; }
        @media (max-width: 800px) { .nav-links { display: none; } }
        .nav-cta { border-radius: 100px; padding: 9px 20px; font-size: 13px; font-weight: 600; }

        .hero { position: relative; min-height: 92vh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 140px 24px 60px; overflow: visible; }
        .hero-swirl-wrap { position: absolute; inset: 0; overflow: hidden; z-index: 0; }
        .badge { position: relative; z-index: 2; display: inline-flex; align-items: center; gap: 8px; padding: 8px 18px; border-radius: 100px; font-size: 12px; font-weight: 500; color: rgba(255,255,255,0.85); margin-bottom: 32px; }
        .hero h1 { position: relative; z-index: 2; font-size: clamp(40px, 6.5vw, 76px); font-style: normal; font-weight: 700; line-height: 1.08; letter-spacing: -0.02em; max-width: 900px; margin-bottom: 24px; font-family: 'Inter', sans-serif; }
        .hero h1 .grad { color: #7dd3fc; font-family: 'Instrument Serif', serif; font-style: italic; font-weight: 500; }
        .hero-shuffle-heading { position: relative; z-index: 2; font-size: clamp(30px, 4.5vw, 54px); font-weight: 700; line-height: 1.18; letter-spacing: -0.02em; max-width: 900px; margin: 0 0 24px; font-family: 'Inter', sans-serif; color: #fff; text-align: center; }
        .hero-sub { position: relative; z-index: 2; color: rgba(255,255,255,0.55); font-size: 16px; max-width: 480px; margin-bottom: 40px; }
        .hero-actions { position: relative; z-index: 2; display: flex; gap: 14px; flex-wrap: wrap; justify-content: center; }
        .btn-solid { padding: 13px 26px; border-radius: 100px; font-size: 14px; font-weight: 600; background: #fff; color: #000; }
        .btn-glass { padding: 12px 26px; border-radius: 100px; font-size: 14px; font-weight: 600; color: #fff; }

        section { padding: 120px 24px; position: relative; }
        .eyebrow { font-size: 12px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: #c084fc; margin-bottom: 16px; text-align: center; }
        .sec-title { font-family: 'Instrument Serif', serif; font-style: italic; font-size: clamp(32px, 4.5vw, 52px); font-weight: 500; text-align: center; margin-bottom: 16px; letter-spacing: -0.01em; }
        .sec-sub { color: rgba(255,255,255,0.5); font-size: 15.5px; max-width: 520px; margin: 0 auto; text-align: center; }

        .boundary-words { display: flex; flex-direction: column; gap: 14px; margin: 56px 0 8px; }
        .word-row { display: flex; align-items: center; justify-content: center; gap: 10px; flex-wrap: wrap; }
        .chip { font-family: monospace; font-size: 12px; padding: 8px 14px; border-radius: 8px; white-space: nowrap; }
        .chip.bad { background: rgba(239,68,68,0.05); border: 1px solid rgba(239,68,68,0.15); color: rgba(239,68,68,0.4); }
        .chip.bad.f1 { opacity: 0.7; } .chip.bad.f2 { opacity: 0.4; } .chip.bad.f3 { opacity: 0.2; }
        .chip.good { background: rgba(192,132,252,0.14); border: 1px solid rgba(192,132,252,0.4); color: #eadcff; font-weight: 500; }

        .features-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; border-radius: 20px; overflow: hidden; margin-top: 64px; }
        @media (max-width: 900px) { .features-grid { grid-template-columns: repeat(2, 1fr); } }
        @media (max-width: 560px) { .features-grid { grid-template-columns: 1fr; } }
        .feature-cell { padding: 30px 24px; }
        .feature-cell h4 { font-size: 15px; font-weight: 600; margin-bottom: 8px; }
        .feature-cell p { font-size: 13px; color: rgba(255,255,255,0.5); line-height: 1.6; }

        .tech-strip { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; margin-top: 56px; }
        .tech-pill { font-family: monospace; font-size: 12px; padding: 9px 18px; border-radius: 100px; color: rgba(255,255,255,0.7); }

        .faq-list { max-width: 720px; margin: 56px auto 0; display: flex; flex-direction: column; gap: 12px; }
        .faq-row { border-radius: 16px; padding: 22px 26px; }
        .faq-row h4 { font-size: 14.5px; font-weight: 600; margin-bottom: 6px; }
        .faq-row p { font-size: 13.5px; color: rgba(255,255,255,0.5); }

        .swirl-cta { text-align: center; overflow: hidden; }
        .swirl-cta-title { font-size: clamp(36px, 5.5vw, 64px); font-style: italic; font-weight: 500; margin-bottom: 18px; }
        .swirl-cta-sub { color: rgba(255,255,255,0.55); font-size: 15.5px; max-width: 480px; margin: 0 auto 40px; }
        .swirl-footer { position: relative; z-index: 2; margin-top: 80px; padding-top: 28px; border-top: 1px solid rgba(255,255,255,0.1); display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; font-size: 12.5px; color: rgba(255,255,255,0.35); max-width: 900px; margin-left: auto; margin-right: auto; }
        .swirl-footer-links { display: flex; gap: 20px; }
        .swirl-footer-links a:hover { color: rgba(255,255,255,0.7); }
      `}</style>
<section className="hero">
        
        <div className="fade-bottom"></div>
        <Shuffle
          text={"The AI That\nNever Leaves\nYour Machine"}
          tag="h1"
          shuffleDirection="right"
          duration={0.4}
          shuffleTimes={1}
          stagger={0.025}
          triggerOnce={true}
          className="hero-shuffle-heading"
          style={{ position: 'relative', zIndex: 2, whiteSpace: 'pre-line' }}
        />
        
        
      </section>

      <div className="tech-strip container reveal">
        <span className="tech-pill liquid-glass">Ollama</span>
        <span className="tech-pill liquid-glass">LangGraph</span>
        <span className="tech-pill liquid-glass">ChromaDB</span>
        <span className="tech-pill liquid-glass">FastAPI</span>
        <span className="tech-pill liquid-glass">SQLite</span>
        <span className="tech-pill liquid-glass">Electron</span>
        <span className="tech-pill liquid-glass">Gemini 2.5</span>
      </div>

      <section id="boundary">
        <div className="reveal">
          <div className="eyebrow">The Boundary</div>
          <h2 className="sec-title">Every message starts<br/>and ends on your machine</h2>
          <p className="sec-sub">By default, nothing you type leaves your device. Add a Gemini key and go online only when you choose to.</p>
        </div>
        <div className="boundary-words reveal">
          <div className="word-row">
            <span className="chip bad f3">Tracked</span>
            <span className="chip bad f2">Synced</span>
            <span className="chip bad f1">Uploaded</span>
            <span className="chip bad">Profiled</span>
            <span className="chip good">Local</span>
            <span className="chip good">Private</span>
          </div>
          <div className="word-row">
            <span className="chip bad f3">Scraped</span>
            <span className="chip bad f2">Logged</span>
            <span className="chip bad f1">Sold</span>
            <span className="chip good">On-Disk</span>
            <span className="chip good">Isolated</span>
          </div>
        </div>
      </section>

      <section id="features">
        <div className="reveal">
          <div className="eyebrow">Capabilities</div>
          <h2 className="sec-title">Everything runs<br/>on your disk</h2>
          <p className="sec-sub">Structured chat history in SQLite. Semantic memory and document search in ChromaDB.</p>
        </div>
        <div className="features-grid reveal">
          <div className="feature-cell liquid-glass"><h4>Local Inference</h4><p>Bundled Ollama runs qwen2.5 and qwen2.5-coder, no manual setup on first launch.</p></div>
          <div className="feature-cell liquid-glass"><h4>Document RAG</h4><p>Upload PDF, DOCX, or TXT — content is chunked, embedded locally, and retrieved by similarity.</p></div>
          <div className="feature-cell liquid-glass"><h4>Vision Analysis</h4><p>MiniCPM-V describes screenshots and diagrams on-device.</p></div>
          <div className="feature-cell liquid-glass"><h4>Persistent Memory</h4><p>Past messages are embedded so the assistant can recall earlier context.</p></div>
        </div>
      </section>

      <section id="stack" style={{textAlign: 'center'}}>
        <div className="reveal">
          <div className="eyebrow">Architecture</div>
          <h2 className="sec-title">Four systems,<br/>one desktop app</h2>
        </div>
        <div className="features-grid reveal">
          <div className="feature-cell liquid-glass"><h4>Electron</h4><p>Starts Ollama and the Python backend, then opens the React UI.</p></div>
          <div className="feature-cell liquid-glass"><h4>FastAPI</h4><p>Owns routing, auth, uploads, and streams model output.</p></div>
          <div className="feature-cell liquid-glass"><h4>React + TypeScript</h4><p>Streaming chat UI with Markdown and code highlighting.</p></div>
          <div className="feature-cell liquid-glass"><h4>SQLite + ChromaDB</h4><p>Structured records and vector search, both local files.</p></div>
        </div>
      </section>

      <section id="faq" style={{textAlign: 'center'}}>
        <div className="reveal">
          <div className="eyebrow">FAQ</div>
          <h2 className="sec-title">Common questions</h2>
        </div>
        <div className="faq-list reveal">
          <div className="faq-row liquid-glass"><h4>Do I need Ollama installed separately?</h4><p>No — Nexachat bundles its own Ollama binary and downloads models automatically on first launch.</p></div>
          <div className="faq-row liquid-glass"><h4>What hardware do I need?</h4><p>An Apple Silicon Mac with 16GB+ unified memory is recommended. Windows is supported via the .exe build.</p></div>
          <div className="faq-row liquid-glass"><h4>Is the Gemini key required?</h4><p>No. Add your own key in a local .env file to enable the optional online mode.</p></div>
          <div className="faq-row liquid-glass"><h4>Where is my data stored?</h4><p>Chat history lives in a local SQLite file; documents and memory embeddings live in a local ChromaDB folder.</p></div>
        </div>
      </section>

      <section id="download" className="swirl-cta">
        
        <div className="fade-top"></div>
        <div style={{position: 'relative', zIndex: 2}} className="reveal">
          <h2 className="swirl-cta-title">Your AI starts here.</h2>
          <p className="swirl-cta-sub">Download Nexachat and run local models today. No account, no cloud dependency — just your machine.</p>
          <div className="hero-actions">
            <a href="https://github.com/KeshavKandoi/OfflineChatBot/releases/latest" className="btn-solid">Download for macOS</a>
            <a href="https://github.com/KeshavKandoi/OfflineChatBot" className="btn-glass liquid-glass">View Source</a>
          </div>
          <div className="swirl-footer">
            <div>© 2026 nexachat — built by Keshav Kandoi</div>
            <div className="swirl-footer-links">
              <a href="https://github.com/KeshavKandoi/OfflineChatBot">GitHub</a>
              <a href="https://github.com/KeshavKandoi/OfflineChatBot/blob/main/LICENSE">MIT License</a>
            </div>
          </div>
        </div>
      </section>
    </>
  );
}
