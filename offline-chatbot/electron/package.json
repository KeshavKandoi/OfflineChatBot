{
  "name": "offline-ai",
  "version": "1.0.0",
  "description": "Offline AI Chatbot",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.keshav.offlineai",
    "productName": "Offline AI",
    "files": [
      "main.js",
      "setup.html",
      "preload.js"
    ],
    "extraResources": [
      { "from": "../backend", "to": "backend" },
      { "from": "../frontend/dist", "to": "frontend/dist" },
      { "from": "binaries", "to": "binaries" }
    ],
    "mac": { "target": "dmg" },
    "win": { "target": "nsis" }
  }
}
