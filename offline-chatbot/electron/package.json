{
  "name": "offline-ai",
  "version": "1.0.1",
  "description": "Offline AI Chatbot",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.keshav.offlineai",
    "productName": "NexaChat",
    "files": [
      "main.js",
      "setup.html",
      "preload.js"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!chat.db",
          "!chatbot.db",
          "!chroma_db/**",
          "!uploads/**",
          "!__pycache__/**",
          "!*.db"
        ]
      },
      {
        "from": "../frontend/dist",
        "to": "frontend/dist"
      }
    ],
    "mac": {
      "target": "dmg",
      "icon": "icon.icns",
      "extraResources": [
        {
          "from": "binaries/mac",
          "to": "binaries/mac"
        }
      ]
    },
    "win": {
      "target": "nsis",
      "extraResources": [
        {
          "from": "binaries/win",
          "to": "binaries/win"
        }
      ]
    }
  }
}
